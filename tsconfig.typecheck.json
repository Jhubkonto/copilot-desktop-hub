{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "electron", "@testing-library/jest-dom"]
  },
  "references": [],
  "include": [
    "src/main/**/*",
    "src/renderer/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/test/**/*"
  ],
  "exclude": ["dist", "node_modules"]
}
